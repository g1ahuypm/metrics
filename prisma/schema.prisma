// ProfitDeck data model. Postgres (Neon, Supabase, Railway, or any Postgres 14+).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, sessions, invites
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // OWNER: full control. ADMIN: everything except removing the owner.
  // PARTNER: read-only access to all reports. SUPPORT: the Support inbox only.
  role         String    @default("PARTNER")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  timeZone     String? // the browser's time zone (e.g. Asia/Ho_Chi_Minh), picked up while they use the app
  sessions     Session[]
  invites      Invite[]  @relation("InviteCreator")

  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksCreated      Task[]             @relation("TaskCreator")
  taskUpdates       TaskUpdate[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  stores            UserStore[] // the stores this person may see (the owner sees all)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  role        String    @default("PARTNER")
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  storeIds    String[]  @default([]) // stores the new member will see
}

// ---------------------------------------------------------------------------
// Workspace settings (single row, id = "default")
// ---------------------------------------------------------------------------

model Settings {
  id        String @id @default("default")
  // The store fields below are the single-store originals: since multi-store they live on Store
  // (copied into the first store once) and are no longer read from here.
  storeName String @default("My Store")
  currency  String @default("USD")
  timezone  String @default("UTC")

  // Shopify. Dev Dashboard apps authenticate with a client ID + secret
  // (client credentials grant; tokens last 24h and are cached below).
  // Legacy admin-created custom apps use a static shpat_ token in shopifyToken.
  shopifyDomain       String?
  shopifyClientId     String?
  shopifyClientSecret String? // encrypted
  shopifyToken        String? // encrypted; static legacy token OR cached short-lived token
  shopifyTokenExpires DateTime? // null for a static legacy token
  lastShopifySyncAt   DateTime?

  // Customer support mailbox (Gmail over IMAP/SMTP with an app password, encrypted)
  supportEmail       String?
  supportAppPassword String?
  supportAutoReply   Boolean   @default(true)
  supportSignature   String?
  supportUidValidity String? // IMAP UIDVALIDITY of INBOX; a change means re-scan
  supportLastUid     Int? // highest INBOX UID already imported
  lastSupportSyncAt  DateTime?
  supportLockUntil   DateTime? // one mail run at a time, so no email is answered twice

  // Phone/browser notifications (Web Push). Keys are created on first use; the private one is encrypted.
  vapidPublicKey     String?
  vapidPrivateKey    String?
  lastTaskReminderAt DateTime?
  storesMigratedAt   DateTime? // when this single-store setup was copied into the first Store

  // Meta Ads (token stored encrypted with APP_SECRET)
  metaAdAccountId String?
  metaToken       String?
  lastMetaSyncAt  DateTime?

  // Cost assumptions used when the source data has no better value
  paymentFeePercent   Float @default(2.9) // % of order total (used when Shopify Payments does not report fees)
  paymentFeeFixed     Float @default(0.30) // per order, in store currency
  platformFeePercent  Float @default(0) // Shopify's extra % when using a third-party gateway (0.5–2%)
  defaultShippingCost Float @default(0) // shipping label cost per order
  defaultHandlingCost Float @default(0) // pick/pack/packaging cost per order
  defaultCogsPercent  Float @default(0) // % of line price used when a variant has no unit cost

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shopify data
// ---------------------------------------------------------------------------

model ProductVariant {
  id           String          @id @default(cuid())
  shopifyId    String          @unique
  storeId      String?
  store        Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String?
  productTitle String
  variantTitle String?
  sku          String?
  price        Float           @default(0) // price in Shopify
  // Cost of goods per unit. Pulled from Shopify InventoryItem.unitCost or
  // edited by hand in the Costs page (manual edits are kept on sync).
  unitCost     Float?
  costSource   String          @default("shopify") // "shopify" | "manual"
  imageUrl     String?
  updatedAt    DateTime        @updatedAt
  lineItems    OrderLineItem[]

  @@index([storeId, productId])
}

// Supplier cost per bundle quantity, per destination country.
// Product-level tiers (variantId = "") apply to every variant of the product;
// variant-level tiers override them. country = "" is the default used for any
// country without its own tiers. productCost and shippingCost are the TOTAL
// for `quantity` units, not per unit.
model CostTier {
  id           String   @id @default(cuid())
  productId    String // ProductVariant.productId (Shopify product gid)
  variantId    String   @default("") // "" = applies to all variants of the product
  country      String   @default("") // ISO 3166-1 alpha-2 (US, CA, AU, GB, NZ); "" = default
  quantity     Int
  productCost  Float    @default(0)
  shippingCost Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([productId, variantId, country, quantity])
  @@index([productId])
}

model Order {
  id                String    @id @default(cuid())
  shopifyId         String    @unique
  storeId           String?
  store             Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String // e.g. #1042
  createdAt         DateTime
  processedAt       DateTime?
  cancelledAt       DateTime?
  financialStatus   String?
  fulfillmentStatus String?
  currency          String    @default("USD")

  subtotal        Float @default(0) // line items after discounts
  shippingCharged Float @default(0) // what the customer paid for shipping
  tax             Float @default(0)
  discounts       Float @default(0)
  total           Float @default(0) // amount charged to the customer
  refunded        Float @default(0)

  // Costs
  cogs            Float    @default(0)
  shippingCost    Float    @default(0) // what you paid to ship
  handlingCost    Float    @default(0) // pick, pack, packaging
  transactionFees Float    @default(0) // payment processing (Shopify Payments / gateway)
  // true: estimated from the fee % in Expenses (re-priced when that changes);
  // false: reported by Shopify; null: synced before this was tracked (left as is).
  feesEstimated   Boolean?
  platformFees    Float    @default(0) // Shopify's third-party gateway surcharge

  customerId          String?
  customerEmail       String?
  country             String? // shipping country (ISO alpha-2)
  presentmentCurrency String? // currency the customer paid in
  isNewCustomer       Boolean @default(false)
  itemCount           Int     @default(0)
  source              String? // e.g. web, pos
  tags                String?

  lineItems OrderLineItem[]

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderLineItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyId    String?
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title        String
  sku          String?
  quantity     Int             @default(1)
  listPrice    Float           @default(0) // line total at list price, before any discount
  price        Float           @default(0) // what the customer paid for this line after ALL discounts
  unitCost     Float           @default(0) // supplier product cost per unit (effective)
  shippingCost Float           @default(0) // supplier shipping for this line (total)
  costSource   String          @default("none") // "tier" | "shopify" | "fallback" | "none"

  @@index([orderId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Meta Ads data
// ---------------------------------------------------------------------------

model Campaign {
  id          String      @id @default(cuid())
  metaId      String      @unique
  name        String
  status      String      @default("ACTIVE")
  objective   String?
  dailyBudget Float?
  productId   String? // ProductVariant.productId this campaign sells (set in the app)
  adAccountId String?
  adAccount   AdAccount?  @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  // The store its spend counts for: the linked product's store, else the ad account's only store.
  // Derived (recomputed on sync and when links change); null = not linked to a store yet.
  storeId     String?
  store       Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  updatedAt   DateTime    @updatedAt
  insights    AdInsight[]

  @@index([productId])
  @@index([storeId])
}

model AdInsight {
  id               String   @id @default(cuid())
  date             DateTime // day (UTC midnight)
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spend            Float    @default(0)
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0) // link clicks
  purchases        Int      @default(0) // platform-attributed purchases
  purchaseValue    Float    @default(0) // platform-attributed revenue
  addToCart        Int      @default(0)
  initiateCheckout Int      @default(0)

  @@unique([date, campaignId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Custom costs (apps, VAs, agency fees, software, one-off purchases, ...)
// ---------------------------------------------------------------------------

model CustomCost {
  id        String    @id @default(cuid())
  name      String
  category  String    @default("Other")
  // MONTHLY: amount per month, spread evenly per day
  // DAILY: amount per day
  // ONE_TIME: amount on startDate
  // PERCENT_REVENUE: amount% of revenue
  // PER_ORDER: amount per order
  type      String    @default("MONTHLY")
  amount    Float
  startDate DateTime
  endDate   DateTime?
  notes     String?
  storeId   String? // null = shared by all stores, split by each store's revenue
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Sync audit log
// ---------------------------------------------------------------------------

model SyncLog {
  id          String    @id @default(cuid())
  source      String // "shopify" | "meta"
  storeId     String? // Shopify syncs
  adAccountId String? // Meta syncs
  status      String // "running" | "success" | "error"
  message     String?
  records     Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

// ---------------------------------------------------------------------------
// Customer support (Support inbox, AI replies, knowledge base)
// ---------------------------------------------------------------------------

model SupportThread {
  id            String           @id @default(cuid())
  key           String // Gmail thread id, or the first message's Message-ID
  storeId       String?
  store         Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject       String
  customerEmail String
  customerName  String?
  // pending: not sorted yet; customer: a real customer or shopper; other: spam, pitches, newsletters, notifications
  category      String           @default("pending")
  topic         String? // KbArticle.key the AI matched
  // new | auto_replied | needs_reply | needs_action | replied | done
  status        String           @default("new")
  summary       String? // one line: what the customer wants
  holdReason    String? // why the AI did not send on its own
  actionNote    String? // what a person has to do (process refund, change address)
  draft         String? // reply waiting for a person
  orderNames    String? // "#LW001289, #LW001290"
  unread        Boolean          @default(true)
  lastMessageAt DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@unique([storeId, key])
  @@index([category, status, lastMessageAt])
  @@index([customerEmail])
}

model SupportMessage {
  id          String        @id @default(cuid())
  threadId    String
  thread      SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId   String // RFC 5322 Message-ID
  storeId     String? // the mailbox it arrived in (one email can reach two stores)
  references  String? // Message-IDs this one replies to, for threading
  direction   String // "in" (from the customer) | "out" (our reply)
  fromEmail   String
  fromName    String?
  toEmail     String
  subject     String
  text        String
  sentAt      DateTime
  sentBy      String? // "AI" or the team member's name, for "out"
  processedAt DateTime? // when the AI handled this inbound message
  history     Boolean       @default(false) // arrived before Support was connected: never auto-answered
  aiAttempts  Int           @default(0) // failed AI tries (rate limit, outage); after 3 a person takes over
  createdAt   DateTime      @default(now())

  @@unique([storeId, messageId])
  @@index([threadId, sentAt])
}

model KbArticle {
  id          String   @id @default(cuid())
  key         String // stable id the AI answers with, e.g. "refund_return"
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String // "Refunds and returns"
  whenToUse   String // which customer questions this answers
  answer      String // the facts and the structure of the reply
  autoSend    Boolean  @default(true) // the AI may send this reply on its own
  flagForTeam Boolean  @default(false) // someone must also act (refund, address change)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([storeId, key])
}

// ---------------------------------------------------------------------------
// Team tasks, the personal inbox and phone/browser notifications

model Task {
  id          String   @id @default(cuid())
  title       String
  details     String
  doneMeans   String // what "finished" looks like, so nobody can save a vague task
  priority    String   @default("normal") // normal | high | urgent
  status      String   @default("open") // open | done
  // Due date and optional time as the assignee reads them, in their own time zone.
  dueDate     String // "2026-10-22"
  dueTime     String? // "17:00"; null = by the end of that day
  dueTimeZone String
  dueAt       DateTime // the moment it becomes overdue
  link        String?
  storeId     String? // optional: which store the task is about
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  assigneeId  String
  assignee    User    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // A pending "I need more time" request from the assignee.
  extensionDate   String?
  extensionTime   String?
  extensionReason String?

  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  updates       TaskUpdate[]
  notifications Notification[]

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
}

model TaskUpdate {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // created | comment | edited | reassigned | due_changed | extension_requested | extension_approved
  // | extension_declined | done | reopened | reminder
  kind      String
  text      String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String
  key       String?   @unique // reminders: one per task, kind and day, even if two checks overlap
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String? // "iPhone", "Chrome on Windows"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Stores (several Shopify stores in one dashboard) and Meta ad accounts
// ---------------------------------------------------------------------------

model Store {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6D4AFF") // dot and chip colour in the store switcher
  sortOrder Int      @default(0)
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  // Shopify (Dev Dashboard app, client credentials grant; secrets encrypted)
  shopifyDomain       String?
  shopifyClientId     String?
  shopifyClientSecret String?
  shopifyToken        String?
  shopifyTokenExpires DateTime?
  lastShopifySyncAt   DateTime?

  // Support mailbox (Gmail over IMAP/SMTP with an app password, encrypted)
  supportEmail       String?
  supportAppPassword String?
  supportAutoReply   Boolean   @default(true)
  supportSignature   String?
  supportAbout       String? // one line for the AI: what the store sells
  supportUidValidity String?
  supportLastUid     Int?
  lastSupportSyncAt  DateTime?
  supportLockUntil   DateTime?

  // Cost assumptions for this store's orders
  paymentFeePercent   Float @default(2.9)
  paymentFeeFixed     Float @default(0.30)
  platformFeePercent  Float @default(0)
  defaultShippingCost Float @default(0)
  defaultHandlingCost Float @default(0)
  defaultCogsPercent  Float @default(0)

  users       UserStore[]
  adAccounts  StoreAdAccount[]
  variants    ProductVariant[]
  orders      Order[]
  campaigns   Campaign[]
  customCosts CustomCost[]
  threads     SupportThread[]
  articles    KbArticle[]
  tasks       Task[]
}

model UserStore {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model AdAccount {
  id            String           @id @default(cuid())
  metaAccountId String           @unique // act_123…
  name          String?
  token         String? // encrypted system-user token with ads_read
  lastSyncAt    DateTime?
  createdAt     DateTime         @default(now())
  stores        StoreAdAccount[]
  campaigns     Campaign[]
}

model StoreAdAccount {
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@id([storeId, adAccountId])
}
