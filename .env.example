# ---- Database ----------------------------------------------------------
# SQLite works out of the box. For production use Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/profitdeck"
#   and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ---- App secrets -------------------------------------------------------
# Used to sign sessions and encrypt the Shopify / Meta tokens stored in the DB.
# Generate one with:  openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string"

# Header value required by /api/cron/sync so only your scheduler can trigger syncs.
CRON_SECRET="change-me-too"

# ---- Optional: pre-fill integrations from the environment --------------
# You can also enter these in Settings inside the app (stored encrypted).
# Shopify custom app: Admin API access token with read_orders, read_products, read_inventory
SHOPIFY_STORE_DOMAIN=""          # e.g. my-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=""          # shpat_...

# Meta Marketing API: long-lived System User token with ads_read
META_AD_ACCOUNT_ID=""            # numeric id, with or without the act_ prefix
META_ACCESS_TOKEN=""

# ---- Optional: seed owner account (used by `npm run db:seed`) ----------
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="password123"
SEED_OWNER_NAME="Store Owner"
# Set to "false" to seed only the owner account without demo data
SEED_DEMO_DATA="true"
